local ESP = {}
ESP.__index = ESP

local RunService = game:GetService("RunService")

ESP.Objects = {}

function ESP:Add(obj, color, pulse, pulseTime)
    if not obj or not obj:IsA("Instance") then
        return warn("Invalid object")
    end

    -- Defaults
    pulse = pulse or false
    pulseTime = pulseTime or 1
    color = color or Color3.fromRGB(255,255,255)

    -- Prevent duplicate ESP
    if obj:FindFirstChild("__esp") then
        return obj.__highlight
    end

    local tag = Instance.new("BoolValue")
    tag.Name = "__esp"
    tag.Parent = obj

    local highlight = Instance.new("Highlight")
    highlight.Name = "__highlight"
    highlight.Adornee = obj
    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    highlight.FillTransparency = 0.8
    highlight.OutlineTransparency = 0
    highlight.FillColor = color
    highlight.OutlineColor = color
    highlight.Parent = obj

    -- GUI support
    for _,v in ipairs(obj:GetDescendants()) do
        if v:IsA("BillboardGui") or v:IsA("SurfaceGui") then
            v.AlwaysOnTop = true
        end
    end

    -- Pulse Effect
    if pulse then
        task.spawn(function()
            local t = 0

            while highlight and highlight.Parent do
                t += RunService.Heartbeat:Wait()

                local alpha = (math.sin((t / pulseTime) * math.pi * 2) + 1) / 2

                highlight.FillTransparency = 0.4 + (alpha * 0.5)
                highlight.OutlineTransparency = alpha * 0.5
            end
        end)
    end

    ESP.Objects[obj] = highlight

    return highlight
end

function ESP:Remove(obj)
    if not obj then return end

    local h = obj:FindFirstChild("__highlight")
    local t = obj:FindFirstChild("__esp")

    if h then
        h:Destroy()
    end

    if t then
        t:Destroy()
    end

    ESP.Objects[obj] = nil
end

function ESP:Toggle(state)
    for obj,highlight in pairs(ESP.Objects) do
        if highlight and highlight.Parent then
            highlight.Enabled = state

            for _,v in ipairs(obj:GetDescendants()) do
                if v:IsA("BillboardGui") or v:IsA("SurfaceGui") then
                    v.AlwaysOnTop = state
                end
            end
        end
    end
end

function ESP:Clear()
    for obj,_ in pairs(ESP.Objects) do
        self:Remove(obj)
    end
end

return ESP
